# Environment template for pe-controlplane and local development.
# Copy to .env, fill in values, and load it before running:
#
#   cp .env.example .env
#   set -a; source .env; set +a
#   ./bin/pe-controlplane
#
# .env is gitignored — never commit real values.

# --- Control plane -----------------------------------------------------------

# Secret used to sign admin session JWTs. If unset, a random one is generated
# per process, which logs everyone out on restart. Generate with:
#   openssl rand -base64 48
JWT_SECRET=

# Seeded admin user, only used when no users exist yet. If ADMIN_PASSWORD is
# unset, one is generated and printed to the log on first start.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# URL agents use to reach the control plane's REST API (backup/restore blob
# transfer). Must be reachable from every enrolled agent, not just localhost.
PUBLIC_URL=http://localhost:8080

# Local directory for backup blobs.
BACKUP_DIR=./data/backups

# Key that encrypts stored database credentials. Set VAULT_KEY directly, or
# leave it empty to use VAULT_KEY_FILE (generated on first start if missing).
# Back the key up: without it, stored credentials cannot be decrypted.
VAULT_KEY=
VAULT_KEY_FILE=./data/vault.key

# PEM certificate and private key for HTTPS and agent gRPC. Leave empty for
# plaintext on loopback only.
TLS_CERT_FILE=
TLS_KEY_FILE=

# Enables AI features (internal/controlplane/ai).
ANTHROPIC_API_KEY=

# --- Database ----------------------------------------------------------------

# Used by `make migrate`. pe-controlplane takes it via --database-url.
# Matches deploy/docker-compose.dev.yml (`make dev`).
DATABASE_URL=postgres://pspocketedge:pspocketedge@localhost:55432/pspocketedge?sslmode=disable

# --- Tests (optional) --------------------------------------------------------

# Postgres for store/API integration tests; those tests skip when unset.
TEST_DATABASE_URL=
# Set to 1 to run Docker-backed agent integration tests.
RUN_DOCKER_INTEGRATION=
RUN_VOLUME_INTEGRATION=
# Set to 1 to run gitsource tests against github.com.
GITSOURCE_LIVE=
